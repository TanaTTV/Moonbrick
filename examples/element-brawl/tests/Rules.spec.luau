return function(t: any)
	local Rules = t.require(game:GetService("ServerScriptService").Server.Rules)
	local Elements = t.require(game:GetService("ReplicatedStorage").Shared.Elements)
	local wind = Elements.byId.Wind.special

	t.test("damage accumulates, ignores bad input and caps at 999", function()
		t.eq(Rules.addDamage(0, 11), 11)
		t.eq(Rules.addDamage(990, 50), 999)
		t.eq(Rules.addDamage(20, -5), 20, "negative damage cannot heal")
		t.eq(Rules.addDamage(20, 0 / 0), 20)
		t.eq(Rules.addDamage(0 / 0, 5), 0)
	end)

	t.test("knockback grows with percent, Smash-style", function()
		local low = Rules.knockback(0, wind)
		local high = Rules.knockback(120, wind)
		t.eq(low, wind.base)
		t.ok(high > low * 3, "120% launches over three times as hard as 0%")
		t.eq(Rules.knockback(0 / 0, wind), wind.base)
	end)

	t.test("launch points away from the attacker and upward", function()
		local right = Rules.launch(50, wind, 1)
		local left = Rules.launch(50, wind, -1)
		t.ok(right.X > 0 and left.X < 0, "horizontal direction follows the side")
		t.ok(right.Y > 0, "launches go up")
		t.eq(right.Z, 0, "fighters stay on the stage plane")
		t.ok(math.abs(right.Magnitude - Rules.knockback(50, wind)) < 1e-6)
	end)

	t.test("hitstun is bounded", function()
		t.eq(Rules.hitstun(0), 0.15)
		t.eq(Rules.hitstun(10000), 1.2)
		t.eq(Rules.hitstun(0 / 0), 0.15)
	end)

	t.test("blast zones", function()
		t.eq(Rules.outOfBounds(Vector3.new(0, 5, 0)), false)
		t.eq(Rules.outOfBounds(Vector3.new(-151, 5, 0)), true)
		t.eq(Rules.outOfBounds(Vector3.new(151, 5, 0)), true)
		t.eq(Rules.outOfBounds(Vector3.new(0, -61, 0)), true)
		t.eq(Rules.outOfBounds(Vector3.new(0, 231, 0)), true)
		t.eq(Rules.outOfBounds(Vector3.new(0 / 0, 0, 0)), true)
	end)

	t.test("melee only hits in front, within reach", function()
		local at = Vector3.new(0, 3, 0)
		t.eq(Rules.inStrike(at, 1, Vector3.new(5, 3, 0)), true)
		t.eq(Rules.inStrike(at, 1, Vector3.new(-5, 3, 0)), false, "behind")
		t.eq(Rules.inStrike(at, -1, Vector3.new(-5, 3, 0)), true, "facing left")
		t.eq(Rules.inStrike(at, 1, Vector3.new(9, 3, 0)), false, "too far")
		t.eq(Rules.inStrike(at, 1, Vector3.new(4, 12, 0)), false, "too high")
	end)

	t.test("sweeps, radius and blink stay inside the arena", function()
		local at = Vector3.new(0, 3, 0)
		t.eq(Rules.inSweep(at, 1, Vector3.new(15, 4, 0), 16, 4), true)
		t.eq(Rules.inSweep(at, 1, Vector3.new(17, 4, 0), 16, 4), false)
		t.eq(Rules.inRadius(at, Vector3.new(8, 8, 50), 13), true, "depth is ignored")
		t.eq(Rules.blinkX(0, 1, 14), 14)
		t.eq(Rules.blinkX(125, 1, 14), 130, "clamped inside the blast zone")
		t.eq(Rules.blinkX(-125, -1, 14), -130)
	end)

	t.test("winner: most stocks, then lowest percent, ties have no winner", function()
		t.eq(Rules.winner({ { name = "A", stocks = 2, percent = 80 }, { name = "B", stocks = 1, percent = 0 } }), "A")
		t.eq(Rules.winner({ { name = "A", stocks = 1, percent = 80 }, { name = "B", stocks = 1, percent = 20 } }), "B")
		t.eq(Rules.winner({ { name = "A", stocks = 1, percent = 20 }, { name = "B", stocks = 1, percent = 20 } }), nil)
		t.eq(Rules.winner({ { name = "A", stocks = 0, percent = 0 } }), nil)
		t.eq(Rules.decided({ { name = "A", stocks = 2, percent = 0 }, { name = "B", stocks = 0, percent = 0 } }), true)
		t.eq(Rules.decided({ { name = "A", stocks = 2, percent = 0 }, { name = "B", stocks = 1, percent = 0 } }), false)
		t.eq(Rules.decided({ { name = "A", stocks = 2, percent = 0 } }), false, "a lone fighter keeps playing")
	end)

	t.test("every element's special is tuned within sane bounds", function()
		for _, id in Elements.order do
			local move = Elements.byId[id].special
			t.ok(move.damage > 0 and move.damage <= 15, id .. " damage")
			t.ok(move.cooldown >= 1.5, id .. " cooldown")
			t.ok(move.angle >= 0 and move.angle <= 90, id .. " angle")
		end
	end)
end
