        "Offset": 0.25,
        "Haze": 1.4,
        "Glare": 0.3,
        "Color": "#C9C4DC",
        "Decay": "#7A6E9C"
      },
      "sky": {
        "CelestialBodiesShown": true,
        "StarCount": 3000,
        "SunAngularSize": 14
      },
      "colorCorrection": {
        "Contrast": 0.08,
        "Saturation": 0.06,
        "TintColor": "#FFF6EC"
      },
      "bloom": {
        "Intensity": 0.5,
        "Size": 24,
        "Threshold": 1.4
      },
      "sunRays": {
        "Intensity": 0.08,
        "Spread": 0.6
      }
    }
