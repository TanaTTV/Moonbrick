{
  "schemaVersion": 1,
  "units": "meters",
  "source": "source/props.blend",
  "style": {
    "name": "Moonstone Garden",
    "genres": [
      "collection sim",
      "cozy fantasy"
    ],
    "references": [
      {
        "source": "Ori and the Blind Forest (key art)",
        "take": "glowing focal object against cool, low-contrast surroundings",
        "avoid": "painterly detail that turns to noise on phones"
      },
      {
        "source": "Pet Simulator 99 (hatch moment)",
        "take": "a 2-3 s hatch with anticipation and a rarity-coloured payoff",
        "avoid": "screen-filling flashes on every hatch"
      }
    ],
    "shapeLanguage": "Broad silhouettes, six-sided crystals, soft low-poly rocks, readable small-screen proportions",
    "materials": "Matte amethyst and slate, restrained gold highlights; one shared palette and material family",
    "lighting": "Cool ambient fill, warm focal light, no global bloom wash; verify readability on mobile",
    "palette": {
      "primary": "#A68AE8",
      "secondary": "#80B6C8",
      "accent": "#FFD785",
      "surface": "#232E48",
      "text": "#F0F4FF"
    },
    "ui": {
      "font": "Nunito",
      "displayFont": "Kalam",
      "corner": 18,
      "stroke": 2,
      "buttonFill": "flat"
    },
    "motion": {
      "feel": "soft and springy: backOut pops, slow idle bobs, short anticipation before rewards"
    },
    "scene": {
      "lighting": {
        "ClockTime": 18.2,
        "Brightness": 2.2,
        "ExposureCompensation": 0.1,
        "Ambient": "#2E3550",
        "OutdoorAmbient": "#5A6688",
        "ColorShift_Top": "#FFE2B8",
        "ColorShift_Bottom": "#26304E",
        "ShadowSoftness": 0.35,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.4
      },
      "atmosphere": {
